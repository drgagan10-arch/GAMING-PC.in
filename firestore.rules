
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'kcYrl8PNXydzKOcxOlqrvPg7yRf2';
    }

    function validRequest() {
      return request.resource.data.keys().hasOnly(['type','fields','status','createdAt'])
        && request.resource.data.status == 'new'
        && request.resource.data.type is string
        && request.resource.data.type.size() <= 40
        && request.resource.data.fields is map
        && request.resource.data.fields.size() <= 20
        && request.resource.data.createdAt == request.time;
    }

    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /games/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /gallery/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reviews/{id} {
      allow read: if resource.data.status == 'approved' || isAdmin();

      allow create: if request.resource.data.keys().hasOnly(['name','rating','text','status','createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.createdAt == request.time;

      allow update, delete: if isAdmin();
    }

    match /{col}/{id} {
      allow create: if col in ['enquiries','quotations','bookings'] && validRequest();
      allow read, update, delete: if col in ['enquiries','quotations','bookings'] && isAdmin();
    }
  }
}
